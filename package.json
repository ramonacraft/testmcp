{
  "name": "testmcp",
  "version": "0.2.0",
  "private": true,
  "description": "TestMCP \u2014 AI QA prediction layer for GitHub PRs. Monorepo: shared core, MCP server, web dashboard.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @testmcp/core && npm run build -w @testmcp/mcp-server && npm run build -w @testmcp/web",
    "web": "npm run start -w @testmcp/web",
    "mcp": "node packages/mcp-server/dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "ip-address": "10.7.4",
    "fast-uri": "3.1.9",
    "body-parser@^1": "1.20.9",
    "body-parser@^2": "2.4.0",
    "brace-expansion": "5.1.0",
    "postcss": "8.5.26",
    "hono": "4.13.16",
    "@hono/node-server": "2.1.11",
    "nanoid": "3.3.18",
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2",
    "vite": "8.2.4",
    "minimatch": "11.0.9",
    "qs": "6.17.1",
    "zod": "4.6.7",
    "express@4": {
      "body-parser": "1.20.9"
    },
    "express@5": {
      "body-parser": "2.4.0"
    }
  },
  "author": "Ramona Bonitatis",
  "license": "MIT"
}
