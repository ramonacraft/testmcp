{
  "name": "testmcp",
  "version": "0.2.0",
  "private": true,
  "description": "TestMCP — AI QA prediction layer for GitHub PRs. Monorepo: shared core, MCP server, web dashboard.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @testmcp/core && npm run build -w @testmcp/mcp-server && npm run build -w @testmcp/web",
    "web": "npm run start -w @testmcp/web",
    "mcp": "node packages/mcp-server/dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "qs": "6.16.0"
  },
  "overrides": {
    "ip-address": "10.7.1",
    "fast-uri": "3.1.8",
    "qs": "$qs",
    "browserslist": "4.28.9",
    "body-parser@^1": "1.20.6",
    "body-parser@^2": "2.3.0",
    "brace-expansion": "5.0.12",
    "postcss": "8.5.26",
    "hono": "4.13.7",
    "@hono/node-server": "1.19.17",
    "nanoid": "3.3.18",
    "source-map-js": "1.2.2",
    "proxy-addr": "2.0.8",
    "@modelcontextprotocol/sdk": "1.31.0"
  },
  "author": "Ramona Bonitatis",
  "license": "MIT"
}
